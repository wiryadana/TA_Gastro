	month = feb,
	year = {2025},
	keywords = {Biomarker, PIVKA-II, Alpha-fetoprotein (AFP), Des-γ-carbonylated prothrombin (DCP), Hepatocellular carcinoma (HCC)},
	pages = {199},
}

