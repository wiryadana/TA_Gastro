	title = {Response {Evaluation} and {Survival} {Prediction} {Following} {PD}‐1 {Inhibitor} in {Patients} {With} {Advanced} {Hepatocellular} {Carcinoma}: {Comparison} of the {RECIST} 1.1, {iRECIST}, and {mRECIST} {Criteria}},
	volume = {11},
